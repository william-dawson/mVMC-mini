FC = mpiifx
CC = mpiicx

CFLAGS = -O3 -qopenmp -xHost
FFLAGS = -O3 -qopenmp -xHost
OPTION = -D_mpi_use -D_lapack

OUT = vmc.out
SRC = vmcmain.c
PFAPACK = pfapack/libpfapack.a
SFMT = sfmt/SFMT.o
OBJS = vmcmain.o $(PFAPACK) $(SFMT)

.PHONY : all pfapack sfmt clean

all : vmc.out

vmc.out : vmcmain.o pfapack sfmt
	$(FC) -o $(OUT) $(OBJS) $(FFLAGS) -qmkl -nofor-main

vmcmain.o : *.c *.h
	$(CC) -c $(SRC) $(OPTION) $(CFLAGS)

pfapack :
	$(MAKE) -C pfapack -f Makefile_intel

sfmt :
	$(MAKE) -C sfmt -f Makefile_intel

clean :
	-rm -f *.o vmc.out
	-rm -f pfapack/*.o pfapack/libpfapack.a
	-rm -f sfmt/*.o
