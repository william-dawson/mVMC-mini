FC = mpif90
CC = mpicc

NVHPC_LIBDIR = /opt/nvidia/hpc_sdk/Linux_aarch64/26.3/compilers/lib
LIB = -L$(NVHPC_LIBDIR) -Wl,-rpath,$(NVHPC_LIBDIR) -llapack -lblas

CFLAGS = -O3 -mp -tp native
FFLAGS = -O3 -mp -tp native
OPTION = -D_mpi_use -D_lapack

OUT = vmc.out
SRC = vmcmain.c
PFAPACK = pfapack/libpfapack.a
SFMT = sfmt/SFMT.o
OBJS = vmcmain.o $(PFAPACK) $(SFMT)

.PHONY : all pfapack sfmt clean

all : vmc.out

vmc.out : vmcmain.o pfapack sfmt
	$(FC) -o $(OUT) $(OBJS) $(FFLAGS) $(LIB)

vmcmain.o : *.c *.h
	$(CC) -c $(SRC) $(OPTION) $(CFLAGS)

pfapack :
	$(MAKE) -C pfapack -f Makefile_nvhpc

sfmt :
	$(MAKE) -C sfmt -f Makefile_nvhpc

clean :
	-rm -f *.o vmc.out
	-rm -f pfapack/*.o pfapack/libpfapack.a
	-rm -f sfmt/*.o
